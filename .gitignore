# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.so

# Virtual environments / conda
.env
.venv
env/
venv/
*.conda

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Large binary / data files (matched everywhere)
*.zip
*.gz
*.tar

# Root-only output directories (use leading / to avoid matching inside submodule dirs)
/demo_output/
/test_output/
/vis_output/

# OpenSim generated output files
*.log
*.sto
*.mot

# NumPy / data output arrays (root-level only)
/demo_output/**/*.npz
/demo_output/**/*.npy

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
notes/*.pdf
